+// RFC 8610 constrains representability, not the input float encoding width.
+fn fits_half(value: f64) -> bool {
+  if !value.is_finite() || value == 0.0 { return true; }
+  let n = value.abs();
+  if n > 65504.0 || n < 2f64.powi(-24) { return false; }
+  let step = 2f64.powi(if n < 2f64.powi(-14) { -24 } else { n.log2().floor() as i32 - 10 });
+  (n / step).fract() == 0.0
+}
